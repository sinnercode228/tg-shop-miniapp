# Token from @BotFather (required)
BOT_TOKEN=123456:replace-me
# Public HTTPS URL of the Mini App (GitHub Pages demo or your own deployment)
WEBAPP_URL=https://sinnercode228.github.io/tg-shop-miniapp/
# Comma-separated Telegram user ids that receive order notifications and admin commands
ADMIN_IDS=
DATABASE_URL=sqlite+aiosqlite:///./tgshop.db
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=https://sinnercode228.github.io,http://localhost:5173
# Max age of Mini App initData in seconds
INIT_DATA_TTL=86400
STARS_ENABLED=true
# Minutes a Stars order may stay unpaid before the bot cancels it; 0 turns this off
ORDER_PAYMENT_TTL_MINUTES=30
# Attempts at a Stars refund (1-20) before the bot marks it failed and tells the admins
REFUND_MAX_ATTEMPTS=8
# Seconds (1-86400) before the first retry of a failed refund; each next retry waits twice as long
REFUND_RETRY_SECONDS=30
LOG_LEVEL=INFO
